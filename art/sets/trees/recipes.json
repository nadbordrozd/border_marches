{
  "set": "trees",
  "bead": "border_marches-xaj.26",
  "class": "trees",
  "exploration": false,
  "_doc": "Small single trees for the dense forest canopy of the adventure map (bead xaj.26, docs/art/classes/trees.md): about 0.35-0.6 cell wide at native display size, never downscaled or mirrored. One generate-image-v2 call per species at 48x48 returns 25 candidates of a mixed subject; the best distinct ones are accepted and cropped to their opaque box plus 1 px. Layers: style, light, class-tree, subject. Recipes are never edited after generation: add a new id (new seed) instead.",
  "shared": {},
  "defaults": {
    "endpoint": "generate-image-v2",
    "fragments": [
      "style",
      "light-south-west",
      "class-tree"
    ],
    "noBackground": true
  },
  "recipes": [
    {
      "id": "grass-conifer-a",
      "concept": "GRASS CONIFERS",
      "width": 48,
      "height": 48,
      "seed": 82101,
      "subject": "Subject: one small evergreen conifer, each image a different one of these: a slim pointed spruce, a fir with three stacked layers of drooping branches, a narrow pine with a blunt tip, a young bushy spruce. Dark cool blue-green #2e6b5a, shadow #1d4a40, lit edges #4f9a7a on the left side, a short brown trunk #5a3a24. Narrow: about half of the image wide and nearly the full image tall."
    },
    {
      "id": "grass-broadleaf-a",
      "concept": "GRASS BROADLEAF",
      "width": 48,
      "height": 48,
      "seed": 82201,
      "subject": "Subject: one small round deciduous tree in summer, each image a different one of these: a round oak with a lumpy crown, a lime tree with an oval crown, a beech with two big leaf lobes, an ash with a loose crown. Fresh leaf green #4f8f3a, shadow #2f5f2a, light #7fb455 on the left side, a short brown trunk #5a3a24. About two thirds of the image wide and nearly the full image tall."
    },
    {
      "id": "grass-autumn-a",
      "concept": "GRASS AUTUMN",
      "width": 48,
      "height": 48,
      "seed": 82301,
      "subject": "Subject: one small round deciduous tree in autumn, each image a different one of these: an orange maple #e07a2a with shadow #a24a1c, a golden yellow birch #e6bf3e with shadow #a8841e and a white trunk, a red-orange oak #cc5a2a with shadow #8a3418, a yellow-green lime #b8b840 with shadow #7a7a2a. A short brown trunk #5a3a24. About two thirds of the image wide and nearly the full image tall."
    },
    {
      "id": "jungle-a",
      "concept": "JUNGLE TREES",
      "width": 48,
      "height": 48,
      "seed": 82401,
      "subject": "Subject: one small jungle tree, each image a different one of these: a palm with a gently curved trunk and five broad drooping fronds, a broadleaf jungle tree with a round dense crown, a banana plant with a few huge paddle leaves, a tree fern with a crown of feathery fronds. Deep bluish greens #2f7a52, shadow #1e5040, light #5aa86c on the left side, trunks brown #6a4a2a. About two thirds of the image wide and nearly the full image tall."
    },
    {
      "id": "steppe-a",
      "concept": "STEPPE TREES",
      "width": 48,
      "height": 48,
      "seed": 82501,
      "subject": "Subject: one small lone steppe tree, each image a different one of these: a squat oak with a round olive crown, a birch with a white trunk and a light airy yellow-green crown, a wind-bent elm with a lopsided crown, a wild pear with a small round crown. Dusty olive green #7a8a3a, shadow #525e28, dry yellow-green light #a8a850 on the left side, trunks grey-brown #6a5236. About two thirds of the image wide and nearly the full image tall."
    },
    {
      "id": "badlands-a",
      "concept": "BADLANDS SCRUB",
      "width": 48,
      "height": 48,
      "seed": 82601,
      "subject": "Subject: one small desert scrub tree, each image a different one of these: a twisted juniper with a dense bushy dark blue-green crown, a mesquite with a flat feathery olive crown, a gnarled dry tree with three clumps of grey-green leaves, a short desert pine with a flat top. Leaves dark sage #4a6a52, shadow #2e4436, light #7a9a6a on the left side, twisted trunks red-brown #7a4a2e. About two thirds of the image wide and most of the image tall."
    },
    {
      "id": "wasteland-a",
      "concept": "WASTELAND DEAD TREES",
      "width": 48,
      "height": 48,
      "seed": 82701,
      "subject": "Subject: one small dead tree after a wildfire, chunky and simple, each image a different one of these: a charred trunk with a few thick broken branches, a grey dead snag with a split top, a burnt pine with a few ash-grey needle tufts, a twisted bare tree with stubby limbs. Charcoal #2e2a28, ash grey #77706a, light grey #a49c94 on the left side, one tiny ember orange #c8642a crack at most. About half of the image wide and nearly the full image tall."
    },
    {
      "id": "wasteland-b",
      "concept": "WASTELAND DEAD TREES, FULL CROWNS",
      "width": 48,
      "height": 48,
      "seed": 82702,
      "subject": "Subject: one small dead tree after a wildfire with a full bushy crown of many short bare twisted branches, chunky and simple, the crown as wide as a living tree's, each image a different one of these: a dead oak with a round tangle of grey branches, a charred pine with drooping black needle tufts, a dead tree with a few dry brown leaves left in its crown, a twisted dead willow. Charcoal #2e2a28, ash grey #77706a, light grey #a49c94 on the left side, dry brown leaves #7a5a3a. About two thirds of the image wide and nearly the full image tall."
    },
    {
      "id": "grass-broadleaf-b",
      "concept": "GRASS BROADLEAF, DEEP GREEN",
      "width": 48,
      "height": 48,
      "seed": 82202,
      "subject": "Subject: one small round deciduous tree in late summer, a dense crown of leaf clumps, each image a different one of these: a round oak, a lime tree with an oval crown, a beech with two leaf lobes, a hornbeam with a lumpy crown. Deep muted leaf green #3f6f34, shadow #27482a, light #5f8f48 on the left side, a short brown trunk #5a3a24. About two thirds of the image wide and nearly the full image tall."
    }
  ],
