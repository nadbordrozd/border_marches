{
  "set": "desert-peaks",
  "bead": "border_marches-bzc.88",
  "class": "mountains",
  "exploration": false,
  "_doc": "The desert's mountains (bead bzc.88, docs/art/classes/mountains.md): pale golden sandstone mesas and wind-carved rock spires, apart from the red-orange badlands buttes. generate-image-v2 at native display size (foothill 56 x 44, peak 80 x 64, summit 120 x 88), cropped to the opaque box plus 1 px. Never scaled, never mirrored. Layers: style, light, class-peak, subject. Recipes are never edited after generation: add a new id (new seed) instead.",
  "shared": {
    "rock": "Rock pale golden sandstone #d6a862, shadow #9a6a3a, lit #efcb8a on the left faces, cream strata stripes #f2dcaa."
  },
  "defaults": {
    "endpoint": "generate-image-v2",
    "fragments": [
      "style",
      "light-south-west",
      "class-peak"
    ],
    "noBackground": true,
    "negative": "red rock, snow, trees, cactus, buildings, sky"
  },
  "recipes": [
    {
      "id": "low-a",
      "concept": "DESERT FOOTHILLS",
      "width": 56,
      "height": 44,
      "seed": 88301,
      "subject": "Subject: one low wind-carved sandstone rock, each image a different one of these: a small flat-topped mesa with level stripes, a rounded wind-smoothed rock with a hollow, a pair of stubby rock fingers. Rock pale golden sandstone #d6a862, shadow #9a6a3a, lit #efcb8a on the left faces, cream strata stripes #f2dcaa. Fills the image width and about two thirds of its height."
    },
    {
      "id": "mid-a",
      "concept": "DESERT PEAKS",
      "width": 80,
      "height": 64,
      "seed": 88302,
      "subject": "Subject: one golden sandstone rock formation, each image a different one of these: a flat-topped mesa with steep fluted cliffs, a tall narrow rock spire with a wider cap, a cluster of two wind-carved rock needles. Rock pale golden sandstone #d6a862, shadow #9a6a3a, lit #efcb8a on the left faces, cream strata stripes #f2dcaa. Nearly the full image wide, three quarters of its height."
    },
    {
      "id": "big-a",
      "concept": "DESERT SUMMITS",
      "width": 120,
      "height": 88,
      "seed": 88303,
      "subject": "Subject: one big golden sandstone formation, each image a different one of these: a wide flat-topped mesa with fluted cliffs and level strata, a group of three tall rock spires on one base, a broad terraced mesa with a sloping sand skirt. Rock pale golden sandstone #d6a862, shadow #9a6a3a, lit #efcb8a on the left faces, cream strata stripes #f2dcaa. Fills nearly the full image."
    },
    {
      "id": "mid-b",
      "concept": "DESERT PEAKS (more mesas, no thin stems)",
      "width": 80,
      "height": 64,
      "seed": 88304,
      "subject": "Subject: one golden sandstone rock formation, each image a different one of these: a wide flat-topped mesa with fluted cliffs, a broad butte with two steps, a chunky cluster of three rock towers, a wide rock with a notched top. Rock pale golden sandstone #d6a862, shadow #9a6a3a, lit #efcb8a on the left faces, cream strata stripes #f2dcaa. Solid and wide at the base. Nearly the full image wide, three quarters of its height."
    },
    {
      "id": "big-b",
      "concept": "DESERT SUMMITS",
      "width": 120,
      "height": 88,
      "seed": 88305,
      "subject": "Subject: one big golden sandstone formation, each image a different one of these: a long flat-topped mesa with fluted cliffs, two joined table rocks , a tall butte on a wide stepped base, a broad rock with three tall needles on its back. Rock pale golden sandstone #d6a862, shadow #9a6a3a, lit #efcb8a on the left faces, cream strata stripes #f2dcaa. Fills nearly the full image."
    }
  ],
