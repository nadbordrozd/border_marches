    {
      "id": "realm-dwellings-a",
      "concept": "REALM DWELLINGS",
      "seed": 74101,
      "styleImage": "@realm",
      "subject": "Subject: each image a different one of these six storybook kingdom buildings: Squires' Hall (small timber-framed hall, a big round wooden shield over the door, a straw practice dummy); Archery Range (open wooden shed with round straw targets with red and white rings); Barracks (long stone barracks, red-brown tiled roof, a rack of spears); Friary (small stone friary with a bell gable and a little garden fence); Stables (timber stable with a hay-loft door and a gold horseshoe sign); Slayers' Lodge (stout stone lodge with a giant green dragon skull over the door). Materials: cream limestone #e6d8b4, white plaster with dark timbers, roofs tabard blue #2f6fd0 or red-brown #a8492f.",
      "negative": "pennant"
    },
    {
      "id": "realm-civic-a",
      "concept": "REALM HALLS, FORT, ECONOMY",
      "seed": 74102,
      "styleImage": "@realm",
      "subject": "Subject: each image a different one of these 8 storybook kingdom buildings: Village Hall (small timber-framed hall with a bell on the roof); Town Hall (two-storey stone and timber hall with a clock tower); City Hall (grand cream stone palace hall with columns and a blue dome); Palisade (short curved stretch of wooden plank palisade with a little gate); Keep (square cream stone keep tower with crenellations and a blue roof); Royal Castle (compact castle: a gatehouse and two round towers with blue cones); Marketplace (market stalls with blue and white striped awnings and crates); Resource Silo (round stone silo beside a woodpile and an ore cart). Materials: cream limestone #e6d8b4, white plaster with dark timbers, roofs tabard blue #2f6fd0 or red-brown #a8492f.",
      "negative": "pennant"
    },
    {
      "id": "realm-civic-b",
      "concept": "REALM GUILD, TAVERN, DRILLS, SPECIALS",
      "seed": 74103,
      "styleImage": "@realm",
      "subject": "Subject: each image a different one of these 8 storybook kingdom buildings: Magic Guild (slender round cream stone wizard tower with a blue pointed roof and gold stars); Tavern (cosy timber inn with a hanging tankard sign); Butts (three straw archery targets under a small wooden roof); Guardroom (small stone guardhouse with an iron-studded door and crossed halberds); Tiltyard (jousting fence with striped poles and a small stand with a blue canopy); Tithe Barn (big timber barn with wheat sheaves and sacks of gold); Chapel of Oaths (small cream chapel with a giant sword set over its door); Round Table (grand round hall of cream stone with a blue dome and a gold crown on top). Materials: cream limestone #e6d8b4, white plaster with dark timbers, roofs tabard blue #2f6fd0 or red-brown #a8492f.",
      "negative": "pennant"
    },
    {
      "id": "restless-dwellings-a",
