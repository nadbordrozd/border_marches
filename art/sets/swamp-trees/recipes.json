{
  "set": "swamp-trees",
  "bead": "border_marches-bzc.126",
  "class": "trees",
  "exploration": false,
  "_doc": "The swamp ground's woods (bead bzc.126, docs/art/classes/trees.md): swamp willows, bald cypresses hung with moss and mangroves on stilt roots. generate-image-v2 at 48 x 48 like set trees (one call returns many candidates of a mixed subject); the best distinct ones are accepted and cropped to their opaque box plus 1 px. Never scaled, never mirrored. Moss hangs in a few thick strands, never a thin fringe (it turns to noise in a crowd). Layers: style, light, class-tree, subject. Recipes are never edited after generation: add a new id (new seed) instead.",
  "shared": {},
  "defaults": {
    "endpoint": "generate-image-v2",
    "fragments": [
      "style",
      "light-south-west",
      "class-tree"
    ],
    "noBackground": true
  },
  "recipes": [
    {
      "id": "willow-a",
      "concept": "SWAMP WILLOWS AND CYPRESSES",
      "width": 48,
      "height": 48,
      "seed": 126201,
      "subject": "Subject: one small swamp tree, chunky and cute, each image a different one of these: a squat swamp willow with a big rounded drooping crown of dull olive-green leaf clumps #6b7f3c (shadow #43552a, light #91a556 on the left side) hanging down in a few thick rounded lobes; a bald cypress with a dense flat-topped crown of dark moss green #4a6436 on a flared buttressed brown trunk #5c4630, two or three thick strands of grey-green moss #93a07a hanging from its branches; a gnarled swamp oak with a round dark olive crown draped with a few thick clumps of grey-green moss. A short thick trunk. A full crown about two thirds of the image wide and nearly the full image tall.",
      "negative": "face, eyes, person, ground, water, puddle, grass, reeds, pot, thin hanging threads, bare branches, flowers"
    },
    {
      "id": "mangrove-a",
      "concept": "MANGROVES AND MOSSY SWAMP TREES",
      "width": 48,
      "height": 48,
      "seed": 126202,
      "subject": "Subject: one small swamp tree, chunky and cute, each image a different one of these: a mangrove with a round dense crown of deep green leaves #4e6a34 (shadow #32462a, light #7a9548 on the left side) standing on a short tangle of thick arched brown stilt roots #6a5236; a squat bald cypress with a cone-shaped crown of dark green #475f34 and a fat flared trunk; a round mossy swamp bush of olive leaves #6b7f3c with a few thick strands of grey-green moss #93a07a. Chunky and solid, about two thirds of the image wide and nearly the full image tall.",
      "negative": "face, eyes, person, ground, water, puddle, grass, reeds, pot, thin hanging threads, bare branches, flowers"
    }
  ],
