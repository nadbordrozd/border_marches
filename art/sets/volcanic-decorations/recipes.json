{
  "set": "volcanic-decorations",
  "bead": "border_marches-bzc.125",
  "class": "decorations",
  "exploration": false,
  "_doc": "Volcanic (hellish plains) decorations (bead bzc.125, docs/art/classes/decorations.md): passable small details at 32 x 32 with the doodad class layer, impassable props on 64 x 64 (one cell) or 128 x 64 (two cells side by side) with the prop class layer. generate-image-v2, no style image, like sets decorations and candy-decorations; one call returns many candidates of a mixed subject, the best distinct ones are accepted and cropped to their opaque box plus 1 px. Recipes are never edited after generation: add a new id (new seed) instead.",
  "shared": {},
  "defaults": {
    "endpoint": "generate-image-v2",
    "fragments": [
      "style",
      "light-south-west",
      "class-doodad"
    ],
    "noBackground": true
  },
  "recipes": [
    {
      "id": "small-a",
      "concept": "VOLCANIC SMALL (passable)",
      "width": 32,
      "height": 32,
      "seed": 125401,
      "subject": "Subject: one tiny detail of a volcanic plain, each image a different one of these: a small crack in black basalt rock #3a3036 with bright orange lava #f07a2a and yellow #ffc03a bubbling up inside it; three glossy black obsidian shards #2a2240 with violet glints #8a6ad0 sticking up; a little round pool of bubbling yellow sulphur #e8d43a with a crusty rim of dark rock; a blackened charred ribcage and a horned skull lying on the ash; a small stubby rock chimney of dark basalt with orange embers #f07a2a puffing from its top; a little red fire salamander #d0402a with orange spots, curled. Small and low, about half of the image wide, much smaller than a person.",
      "negative": "ground patch, shadow, person, gold, coins, gem, chest, smoke cloud, blur"
    },
    {
      "id": "small-b",
      "concept": "VOLCANIC SMALL (passable)",
      "width": 32,
      "height": 32,
      "seed": 125402,
      "subject": "Subject: one tiny detail of a volcanic plain, each image a different one of these: a small heap of grey ash #6a6266 with glowing orange cinders #f07a2a in it; a red-orange fire lily flower #e8502a with yellow tips growing from black rock; a little cluster of pointed yellow sulphur crystals #e8d43a; a small black beetle with a glowing orange back #f07a2a; a burnt black tree stump #2e2628 with orange ember cracks; a few round grey pumice stones. Small and low, about half of the image wide, much smaller than a person.",
      "negative": "ground patch, shadow, person, gold, coins, gem, chest, smoke cloud, blur"
    },
    {
      "id": "props-1x1-a",
      "concept": "VOLCANIC PROPS 1x1 (impassable)",
      "fragments": [
        "style",
        "light-south-west",
        "class-prop"
      ],
      "width": 64,
      "height": 64,
      "seed": 125501,
      "subject": "Subject: one big blocking volcanic prop filling one map cell, each image a different one of these: a cluster of tall hexagonal basalt columns #3a3036 with flat tops of different heights; a big black rock shaped like two huge curved demon horns #3a3036 with red-brown tips #7a2a22; a tall jagged spire of glossy black obsidian #2a2240 with violet edges #8a6ad0; a big round basalt boulder with orange lava cracks #f07a2a. About three quarters of the image wide and tall.",
      "negative": "ground patch, person, face, flag, water, smoke cloud, flames"
    },
    {
      "id": "props-2x1-a",
      "concept": "VOLCANIC PROPS 2x1 (impassable)",
      "fragments": [
        "style",
        "light-south-west",
        "class-prop"
      ],
      "width": 128,
      "height": 64,
      "seed": 125502,
      "subject": "Subject: one long blocking volcanic prop across the image from left to right, each image a different one of these: a huge fallen tree trunk burnt black #2e2628 with orange ember cracks #f07a2a and broken branch stubs; the blackened ribcage and horned skull of a giant beast #4a3c3a lying on its side; a row of hexagonal basalt columns #3a3036 of different heights; a low ridge of black obsidian #2a2240 in chunky pieces. Nearly the full image wide and two thirds of it tall.",
      "negative": "ground patch, person, face, flag, water, smoke cloud, flames"
    }
