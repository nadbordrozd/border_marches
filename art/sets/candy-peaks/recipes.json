{
  "set": "candy-peaks",
  "bead": "border_marches-bzc.115",
  "class": "mountains",
  "exploration": false,
  "_doc": "The Candy Kingdom frosting ground's mountains (bead bzc.115, docs/art/classes/mountains.md): gumdrop hills and rock-candy crags in strawberry pink under poured royal icing, the candy answer to the snow family's snow caps. generate-image-v2 at native display size (foothill 56 x 44, peak 80 x 64, summit 120 x 88), cropped to the opaque box plus 1 px. Never scaled, never mirrored. Layers: style, light, class-peak, subject. Recipes are never edited after generation: add a new id (new seed) instead.",
  "shared": {},
  "defaults": {
    "endpoint": "generate-image-v2",
    "fragments": [
      "style",
      "light-south-west",
      "class-peak"
    ],
    "noBackground": true,
    "negative": "face, eyes, trees, lollipop, buildings, sky, plate, terraces, crater"
  },
  "recipes": [
    {
      "id": "low-a",
      "concept": "CANDY FOOTHILLS",
      "width": 56,
      "height": 44,
      "seed": 115301,
      "subject": "Subject: one low candy hill, each image a different one of these: a fat round gumdrop hill with a sugar crust, a small lumpy mound of rock-candy crystals, a pair of round gumdrop hummocks side by side. Strawberry pink #d65a94, shadow #9c3468, lit #ee8cb8 on the left faces; white icing #fff4ec (shadow #e3cfc4) poured over the top in rounded drips. Fills the image width and about two thirds of its height."
    },
    {
      "id": "mid-a",
      "concept": "CANDY PEAKS",
      "width": 80,
      "height": 64,
      "seed": 115302,
      "subject": "Subject: one candy mountain, each image a different one of these: a tall rounded gumdrop mountain with an icing cap, a jagged crag of big rock-candy crystals with icing on its tips, a lumpy peak of stacked gumdrops. Strawberry pink #d65a94, shadow #9c3468, lit #ee8cb8 on the left faces; white icing #fff4ec (shadow #e3cfc4) poured over the top in rounded drips. Wide at the base, nearly the full image wide."
    },
    {
      "id": "big-a",
      "concept": "CANDY SUMMITS",
      "width": 120,
      "height": 88,
      "seed": 115303,
      "subject": "Subject: one big candy mountain, each image a different one of these: a huge rounded gumdrop mountain with a thick dripping icing cap, a big jagged rock-candy massif with iced peaks, two joined gumdrop peaks with icing caps. Strawberry pink #d65a94, shadow #9c3468, lit #ee8cb8 on the left faces; white icing #fff4ec (shadow #e3cfc4) poured over the top in rounded drips. Fills nearly the full image."
    },
    {
      "id": "mid-b",
      "concept": "CANDY PEAKS",
      "width": 80,
      "height": 64,
      "seed": 115304,
      "subject": "Subject: one candy mountain, each image a different one of these: a broad lumpy rock-candy mountain under an icing cap, a pointed gumdrop peak with a smaller gumdrop shoulder, a wide crag of sugar crystals with two tips. Strawberry pink #d65a94, shadow #9c3468, lit #ee8cb8 on the left faces; white icing #fff4ec (shadow #e3cfc4) poured over the top in rounded drips. Wide at the base, nearly the full image wide."
    },
    {
      "id": "big-b",
      "concept": "CANDY SUMMITS",
      "width": 120,
      "height": 88,
      "seed": 115305,
      "subject": "Subject: one big candy mountain, each image a different one of these: a wide mountain of three rounded gumdrop peaks under one icing cap, a tall rock-candy crag with a broad base and icing drips, a huge pointed gumdrop peak. Strawberry pink #d65a94, shadow #9c3468, lit #ee8cb8 on the left faces; white icing #fff4ec (shadow #e3cfc4) poured over the top in rounded drips. Fills nearly the full image."
    }
  ],
