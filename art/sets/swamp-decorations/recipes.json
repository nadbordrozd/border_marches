{
  "set": "swamp-decorations",
  "bead": "border_marches-bzc.126",
  "class": "decorations",
  "exploration": false,
  "_doc": "Swamp decorations (bead bzc.126, docs/art/classes/decorations.md): passable small details at 32 x 32 with the doodad class layer, impassable props on 64 x 64 (one cell) or 128 x 64 (two cells side by side) with the prop class layer. generate-image-v2, no style image, like set decorations; one call returns many candidates of a mixed subject, the best distinct ones are accepted and cropped to their opaque box plus 1 px. Recipes are never edited after generation: add a new id (new seed) instead.",
  "shared": {},
  "defaults": {
    "endpoint": "generate-image-v2",
    "fragments": [
      "style",
      "light-south-west",
      "class-doodad"
    ],
    "noBackground": true
  },
  "recipes": [
    {
      "id": "small-a",
      "concept": "SWAMP SMALL (passable)",
      "width": 32,
      "height": 32,
      "seed": 126401,
      "subject": "Subject: one tiny swamp detail, each image a different one of these: two round green lily pads #5f9a3e with one pink water-lily flower #f0a0c0; a clump of three tall brown cattails #7a4a26 on green stalks #6b8a3a; a little cluster of pale glowing swamp mushrooms with teal caps #6fd6c4; a small round floating will-o'-wisp, a soft pale green-blue light #b8f0d8 with a brighter white core; a fat little green frog #6aa040 sitting on a round mossy stone #6e6a58. Small and low, about half of the image wide, much smaller than a person.",
      "negative": "ground patch, water patch, puddle, shadow, person, gold, coins, gem, chest, jar, pot, plate"
    },
    {
      "id": "small-b",
      "concept": "SWAMP SMALL (passable)",
