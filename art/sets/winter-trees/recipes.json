    {
      "id": "snow-conifer-a",
      "concept": "SNOWY CONIFERS",
      "width": 48,
      "height": 48,
      "seed": 87201,
      "subject": "Subject: one small evergreen conifer laden with fresh snow, each image a different one of these: a slim pointed spruce with a white snow cap on every layer of branches, a fir with three stacked drooping layers heavy with thick snow, a narrow pine with a blunt snowy tip, a young bushy spruce dusted with snow. Dark cool blue-green needles #2a5a52, shadow #1b3d3a, snow white #eef4fa with pale blue shadows #b8c8dc on the right side, a short brown trunk #5a3a24. Narrow: about half of the image wide and nearly the full image tall.",
      "negative": "snowman, ground, snow mound, snow patch under the tree, ornaments, star, lights, person"
    },
    {
      "id": "snow-mixed-a",
      "concept": "SNOWY LARCH, BIRCH, JUNIPER, PINE",
      "width": 48,
      "height": 48,
      "seed": 87202,
      "subject": "Subject: one small tree in deep winter, chunky and simple, each image a different one of these: a frosted larch with a full cone-shaped crown of bare golden-brown twigs #8a6a3c capped with snow, a white birch with a white trunk and a full round crown of thick snow-covered branches, a squat dark juniper with snow lying on top, a round snow-laden pine with a dense dark green crown #2f5a48. Snow white #eef4fa with pale blue shadows #b8c8dc on the right side. About two thirds of the image wide and nearly the full image tall.",
      "negative": "snowman, ground, snow mound, snow patch under the tree, ornaments, person, thin bare pole"
    }
  ],
