{
  "set": "desert-trees",
  "bead": "border_marches-bzc.88",
  "class": "trees",
  "exploration": false,
  "_doc": "The desert's woods (bead bzc.88, docs/art/classes/trees.md): palm and cactus groves on sand. generate-image-v2 at 48 x 48 like set trees (one call returns many candidates of a mixed subject); the best distinct ones are accepted and cropped to their opaque box plus 1 px. Never scaled, never mirrored. Layers: style, light, class-tree, subject. Recipes are never edited after generation: add a new id (new seed) instead.",
  "shared": {},
  "defaults": {
    "endpoint": "generate-image-v2",
    "fragments": [
      "style",
      "light-south-west",
      "class-tree"
    ],
    "noBackground": true
  },
  "recipes": [
    {
      "id": "palm-a",
      "concept": "DESERT PALMS",
      "width": 48,
      "height": 48,
      "seed": 88201,
      "subject": "Subject: one small desert oasis palm tree, each image a different one of these: a date palm with a round crown of arching fronds and a cluster of orange dates, a short squat fan palm with a bushy crown, a young palm with a slightly leaning ringed trunk, a double palm with two crowns from one base. Fronds deep olive green #4f7a3a, shadow #2f5028, light #7fa356 on the left side; a ringed tan trunk #a27a4a with shadow #6e4e2c. A full crown about two thirds of the image wide, nearly the full image tall.",
      "negative": "coconut, beach, sand patch, ground, grass, flowers, pot"
    },
    {
      "id": "cactus-a",
      "concept": "DESERT CACTI",
      "width": 48,
      "height": 48,
      "seed": 88202,
      "subject": "Subject: one desert cactus, each image a different one of these: a tall saguaro with two raised arms, a chunky saguaro with one arm, a big clump of round prickly pear pads with a few pink fruits, a cluster of three ribbed column cacti of different heights, a fat round barrel cactus with a yellow flower on top. Cactus green #5f8a4a, shadow #3a5a34, light #8fb36a on the left side, pale spines. Chunky and solid, about half of the image wide and most of the image tall.",
      "negative": "pot, flower pot, sand patch, ground, face, eyes, skull"
    }
  ],
